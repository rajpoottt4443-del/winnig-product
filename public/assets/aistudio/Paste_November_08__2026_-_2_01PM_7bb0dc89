  product,
  activeTab,
  setActiveTab,
  onClose,
  isSaved,
  onToggleSave,
  onCopy,
  copiedId,
  getVerdictStyle
}) {
  // Interactive Profit & Sourcing Calculator State initialized from product values
  const [cogs, setCogs] = useState(Number(product.sourcingCost) || 8.5);
  const [sellingPrice, setSellingPrice] = useState(Number(product.sellingPrice) || 39.99);
  const [shippingCost, setShippingCost] = useState(Number(product.estimatedShipping) || 4.5);
  const [cpa, setCpa] = useState(Number(product.estimatedCPA) || 12.0);
  const [processingFeePct, setProcessingFeePct] = useState(2.9);
  const [monthlyUnits, setMonthlyUnits] = useState(300);

  // Sync calculator sliders when switching products
  useEffect(() => {
    setCogs(Number(product.sourcingCost) || 8.5);
    setSellingPrice(Number(product.sellingPrice) || 39.99);
    setShippingCost(Number(product.estimatedShipping) || 4.5);
    setCpa(Number(product.estimatedCPA) || 12.0);
  }, [product]);

  // Real-time Unit Economics math
  const paymentFeeDollar = (sellingPrice * processingFeePct) / 100 + 0.3;
  const totalLandedCost = cogs + shippingCost + paymentFeeDollar;
  const grossMarginBeforeAds = sellingPrice - totalLandedCost;
  const netProfitPerUnit = grossMarginBeforeAds - cpa;
  const netMarginPct = sellingPrice > 0 ? Math.round((netProfitPerUnit / sellingPrice) * 100) : 0;
  const breakEvenROAS =
    grossMarginBeforeAds > 0 ? (sellingPrice / grossMarginBeforeAds).toFixed(2) : '∞';
  const achievedROAS = cpa > 0 ? (sellingPrice / cpa).toFixed(2) : '∞';
  const monthlyRevenue = Math.round(sellingPrice * monthlyUnits);
  const monthlyNetProfit = Math.round(netProfitPerUnit * monthlyUnits);

