// ============================================================================
// ROBUST JSON EXTRACTION & REPAIR HELPER
// ============================================================================
function extractAndParseJSON(rawText) {
  if (!rawText || typeof rawText !== 'string') {
    throw new Error('Empty or non-string response from AI engine.');
  }

  // Strip markdown code blocks if present
  let cleaned = rawText
    .replace(/```json\s*/gi, '')
    .replace(/```\s*/g, '')
    .trim();

  // Attempt direct parse first
  try {
    return JSON.parse(cleaned);
  } catch (e) {
    // Locate first { or [ and last } or ]
    const firstBrace = cleaned.indexOf('{');
    const firstBracket = cleaned.indexOf('[');
    let startIdx = -1;
    let endIdx = -1;

    if (firstBrace !== -1 && (firstBracket === -1 || firstBrace < firstBracket)) {
      startIdx = firstBrace;
      endIdx = cleaned.lastIndexOf('}');
    } else if (firstBracket !== -1) {
      startIdx = firstBracket;
      endIdx = cleaned.lastIndexOf(']');
    }

    if (startIdx !== -1 && endIdx !== -1 && endIdx > startIdx) {
      let substring = cleaned.slice(startIdx, endIdx + 1);
      // Repair common LLM JSON quirks: trailing commas before } or ]
      substring = substring.replace(/,\s*([}\]])/g, '$1');
      try {
        return JSON.parse(substring);
      } catch (innerErr) {
        // Further cleanup of control characters inside strings
        const sanitized = substring.replace(/[\u0000-\u0019]+/g, ' ');
        return JSON.parse(sanitized);
      }
    }
    throw new Error('Failed to parse structured JSON from AI output.');
  }
}

// ============================================================================
// REAL API CALL ADAPTERS (GEMINI, GROQ, OPENROUTER)
// ============================================================================
async function callGeminiAPI(apiKey, systemInstruction, userPrompt) {
  const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey.trim())}`;
  const startTime = performance.now();

  const response = await fetch(endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      systemInstruction: {
        parts: [{ text: systemInstruction }]
      },
      contents: [
        {
          role: 'user',
          parts: [{ text: userPrompt }]
        }
      ],
      generationConfig: {
        temperature: 0.35,
        responseMimeType: 'application/json'
      }
    })
  });

  const latency = Math.round(performance.now() - startTime);

  if (!response.ok) {
    let errText = `HTTP ${response.status}`;
    try {
      const errJson = await response.json();
      errText = errJson?.error?.message || errText;
    } catch (_) {}
    throw new Error(`Gemini API Error: ${errText}`);
  }

  const data = await response.json();
  const text = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
  return { text, latency, provider: 'Google Gemini (gemini-2.5-flash)' };
}

async function callGroqAPI(apiKey, systemInstruction, userPrompt) {
  const endpoint = 'https://api.groq.com/openai/v1/chat/completions';
  const startTime = performance.now();

  const response = await fetch(endpoint, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      Authorization: `Bearer ${apiKey.trim()}`
    },
    body: JSON.stringify({
      model: 'llama-3.3-70b-versatile',
      temperature: 0.3,
      response_format: { type: 'json_object' },
      messages: [
        { role: 'system', content: systemInstruction + '\nRespond strictly with valid JSON.' },
        { role: 'user', content: userPrompt }
      ]
    })
  });

  const latency = Math.round(performance.now() - startTime);

  if (!response.ok) {
    let errText = `HTTP ${response.status}`;
    try {
      const errJson = await response.json();
      errText = errJson?.error?.message || errText;
    } catch (_) {}
    throw new Error(`Groq API Error: ${errText}`);
  }

  const data = await response.json();
  const text = data?.choices?.[0]?.message?.content || '';
  return { text, latency, provider: 'Groq LPU (llama-3.3-70b-versatile)' };
}

async function callOpenRouterAPI(apiKey, model, systemInstruction, userPrompt) {
  const endpoint = 'https://openrouter.ai/api/v1/chat/completions';
  const startTime = performance.now();
  const chosenModel = model || 'meta-llama/llama-3.3-70b-instruct';

  const makeRequest = async (targetModel) => {
    return fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${apiKey.trim()}`,
        'HTTP-Referer': window.location.origin || 'https://winning-product-hunter.app',
        'X-Title': 'Triple-AI Winning Product Hunter'
      },
      body: JSON.stringify({
        model: targetModel,
        temperature: 0.35,
        messages: [
          {
            role: 'system',
            content: systemInstruction + '\nIMPORTANT: Return ONLY raw valid JSON without markdown codeblocks.'
          },
          { role: 'user', content: userPrompt }
        ]
      })
    });
  };

  let response = await makeRequest(chosenModel);
  let usedModel = chosenModel;

  // Automatic fallback if selected OpenRouter model is unavailable or requires extra credits
  if (!response.ok && chosenModel !== 'meta-llama/llama-3.1-8b-instruct') {
    usedModel = 'meta-llama/llama-3.1-8b-instruct';
    response = await makeRequest(usedModel);
  }

  const latency = Math.round(performance.now() - startTime);

  if (!response.ok) {
    let errText = `HTTP ${response.status}`;
    try {
      const errJson = await response.json();
      errText = errJson?.error?.message || errText;
    } catch (_) {}
    throw new Error(`OpenRouter API Error: ${errText}`);
  }

  const data = await response.json();
  const text = data?.choices?.[0]?.message?.content || '';
  return { text, latency, provider: `OpenRouter (${usedModel})` };
}

