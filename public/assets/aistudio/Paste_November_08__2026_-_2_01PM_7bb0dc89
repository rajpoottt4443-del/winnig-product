              }`}
            >
              <Bookmark className="w-3.5 h-3.5" />
              {isSaved ? 'Bookmarked' : 'Bookmark'}
            </button>
            <button
              onClick={onClose}
              className="p-2 bg-[#0A0A0C] hover:bg-[#1F1F26] border border-[#232329] text-[#A1A1AA] hover:text-white"
              title="Close Drawer"
            >
              <X className="w-4 h-4" />
            </button>
          </div>
        </div>

